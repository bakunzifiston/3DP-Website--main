APP_NAME="3DP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Development only: lets `php artisan serve` handle parallel requests from the SPA.
PHP_CLI_SERVER_WORKERS=4
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8+ or MariaDB 10.4+. Create a dedicated database and a user limited to it (see README).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=threedp_cms
DB_USERNAME=threedp_app
DB_PASSWORD=

# Sessions are stored in MySQL. Use SESSION_SECURE_COOKIE=true in production (HTTPS).
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Hosts whose requests are treated as the site's own frontend (session + CSRF). Include the port in development.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# Production behind a reverse proxy / load balancer: the proxy IP(s), or *
TRUSTED_PROXIES=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Used only by "php artisan db:seed" to create the first admin account (when no users exist).
# Leave ADMIN_PASSWORD empty to have a random one generated and printed once.
ADMIN_NAME="3DP Administrator"
ADMIN_EMAIL=admin@3dp.rw
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
